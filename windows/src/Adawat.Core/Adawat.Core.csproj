<Project Sdk="Microsoft.NET.Sdk">
  <!-- Every conversion and tool, with no window code, so the app and the command line share it.
       Built twice: for Windows (WPF, WinRT and WebView2 underneath) and for plain net10.0, which the Linux app uses.
       What differs between the two lives in Platform/Windows and Platform/Linux, behind the same names. -->
  <PropertyGroup>
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net10.0-windows10.0.22621.0;net10.0</TargetFrameworks>
    <RootNamespace>Adawat.Core</RootNamespace>
    <UseWPF Condition="$(TargetFramework.Contains('-windows'))">true</UseWPF>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="15.0.0" />
    <PackageReference Include="PDFsharp" Version="6.2.4" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="ExcelDataReader" Version="3.9.0" />
    <PackageReference Include="Markdig" Version="1.4.1" />
    <PackageReference Include="SharpCompress" Version="1.0.0" />
    <PackageReference Include="QRCoder" Version="1.8.1" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>
  <ItemGroup Condition="$(TargetFramework.Contains('-windows'))">
    <PackageReference Include="PDFtoImage" Version="5.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Compile Remove="Platform/Linux/**" />
  </ItemGroup>
  <ItemGroup Condition="!$(TargetFramework.Contains('-windows'))">
    <!-- 5.2 is the last PDFtoImage on SkiaSharp 3, which Avalonia 12 draws with; 5.3 moved to SkiaSharp 4. -->
    <PackageReference Include="PDFtoImage" Version="5.2.1" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <Compile Remove="Platform/Windows/**" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Adawat.Core.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- WithCulture="false": the ".ar" in the name would otherwise move the file into an Arabic satellite assembly. -->
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../shared/strings.ar.json" LogicalName="strings.ar.json" WithCulture="false" />
    <EmbeddedResource Include="$(MSBuildThisFileDirectory)../../shared/patterns.ar.json" LogicalName="patterns.ar.json" WithCulture="false" />
  </ItemGroup>
</Project>
